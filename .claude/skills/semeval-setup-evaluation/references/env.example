# Copy to .env (gitignored) and fill in. Where each value comes from:
# `uv run eval-docs show access-and-credentials`.

# Langfuse project: Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# The shared scoring service (VPN). The deployed URL is in
# `uv run eval-docs show scoring-service/04-api-reference`.
OFFLINE_SCORING_BASE_URL=
OFFLINE_SCORING_TIMEOUT_SECONDS=120
